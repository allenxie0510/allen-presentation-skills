{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:allen-ai-skills:corporate-training-workshop:native-pptx-profile:0.1",
  "title": "Workshop Native PPTX Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "meta", "canonical_canvas", "renderer_canvas", "grid", "typography", "cadence", "imagery", "qa"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "meta": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "status", "theme", "renderer"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "status": {"enum": ["draft", "candidate", "approved"]},
        "theme": {"$ref": "#/$defs/slug"},
        "renderer": {"type": "string", "minLength": 3},
        "reviewed_by": {"type": "string", "minLength": 2},
        "reviewed_at": {"type": "string", "format": "date-time"}
      }
    },
    "canonical_canvas": {"$ref": "#/$defs/canvas"},
    "renderer_canvas": {"$ref": "#/$defs/canvas"},
    "grid": {
      "type": "object", "additionalProperties": false,
      "required": ["columns", "edge_minimum", "gap_minimum", "alignment_tolerance"],
      "properties": {
        "columns": {"const": 12},
        "edge_minimum": {"type": "number", "minimum": 53},
        "gap_minimum": {"type": "number", "minimum": 12},
        "alignment_tolerance": {"type": "number", "minimum": 0, "maximum": 8}
      }
    },
    "typography": {
      "type": "object", "additionalProperties": false,
      "required": ["families", "minimums", "title_line_height", "body_line_height"],
      "properties": {
        "families": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "minimums": {
          "type": "object", "additionalProperties": false,
          "required": ["deck_title", "slide_title", "midlevel", "body", "caption"],
          "properties": {
            "deck_title": {"type": "number", "minimum": 60},
            "slide_title": {"type": "number", "minimum": 42},
            "midlevel": {"type": "number", "minimum": 28},
            "body": {"type": "number", "minimum": 20},
            "caption": {"type": "number", "minimum": 12}
          }
        },
        "title_line_height": {"type": "number", "minimum": 1, "maximum": 1.2},
        "body_line_height": {"type": "number", "minimum": 1.2, "maximum": 1.6}
      }
    },
    "cadence": {
      "type": "object", "additionalProperties": false,
      "required": ["energies", "max_same_energy_run", "max_same_silhouette_run", "contact_sheet_required"],
      "properties": {
        "energies": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"enum": ["quiet", "working", "peak"]}},
        "max_same_energy_run": {"type": "integer", "minimum": 1, "maximum": 3},
        "max_same_silhouette_run": {"type": "integer", "minimum": 1, "maximum": 3},
        "contact_sheet_required": {"const": true}
      }
    },
    "imagery": {
      "type": "object", "additionalProperties": false,
      "required": ["real_assets_first", "evidence_slots_must_be_filled", "synthetic_must_be_disclosed", "slot_ratio_preflight", "semantic_artifacts_only", "cast_continuity_when_recurring", "required_metadata"],
      "properties": {
        "real_assets_first": {"const": true},
        "evidence_slots_must_be_filled": {"const": true},
        "synthetic_must_be_disclosed": {"const": true},
        "slot_ratio_preflight": {"const": true},
        "semantic_artifacts_only": {"const": true},
        "cast_continuity_when_recurring": {"const": true},
        "required_metadata": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"enum": ["alt", "fit", "crop_or_position", "provenance", "disclosure"]}}
      }
    },
    "qa": {
      "type": "object", "additionalProperties": false,
      "required": ["render_every_slide", "inspect_full_size", "inspect_contact_sheet", "check_outside_bounds", "check_internal_overlap", "check_font_substitution", "check_unexpected_wrap", "check_image_crop", "check_in_image_labels", "sources_required"],
      "properties": {
        "render_every_slide": {"const": true}, "inspect_full_size": {"const": true},
        "inspect_contact_sheet": {"const": true}, "check_outside_bounds": {"const": true},
        "check_internal_overlap": {"const": true}, "check_font_substitution": {"const": true},
        "check_unexpected_wrap": {"const": true}, "check_image_crop": {"const": true},
        "check_in_image_labels": {"const": true},
        "sources_required": {"const": true}
      }
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "canvas": {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}}
  }
}
