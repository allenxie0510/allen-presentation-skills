{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:allen-ai-skills:presentation-core:scenario:0.2",
  "title": "Professional Presentation Scenario",
  "description": "Communication logic for a professional presentation scenario, independent of industry and visual style.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario",
    "communication_job",
    "audience",
    "decision_types",
    "storyline_patterns",
    "evidence_standard",
    "density",
    "preferred_grammar",
    "required_archetypes",
    "theme_recommendations",
    "component_recipes",
    "anti_patterns"
  ],
  "properties": {
    "schema_version": {"const": "0.2"},
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"}
      }
    },
    "communication_job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "success_condition"],
      "properties": {
        "primary": {"type": "string", "minLength": 1},
        "success_condition": {"type": "string", "minLength": 1}
      }
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "decision_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "storyline_patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/slug"}
    },
    "evidence_standard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "claim_policy", "source_policy"],
      "properties": {
        "level": {"enum": ["low", "moderate", "high"]},
        "claim_policy": {"type": "string", "minLength": 1},
        "source_policy": {"type": "string", "minLength": 1}
      }
    },
    "density": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "range"],
      "properties": {
        "default": {"$ref": "#/$defs/density"},
        "range": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/density"}
        }
      }
    },
    "preferred_grammar": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/grammar"}
    },
    "required_archetypes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/slug"}
    },
    "theme_recommendations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "alternatives", "selection_note"],
      "properties": {
        "default": {"$ref": "#/$defs/slug"},
        "alternatives": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/slug"}
        },
        "selection_note": {"type": "string", "minLength": 1}
      }
    },
    "component_recipes": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {"$ref": "#/$defs/componentRecipe"}
    },
    "anti_patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/slug"}
    },
    "default_permission_profile": {
      "enum": ["locked", "content-only", "content-style", "freeform"]
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "density": {
      "enum": ["low", "medium", "medium-high", "high"]
    },
    "grammar": {
      "enum": [
        "assertion",
        "evidence",
        "trend",
        "comparison",
        "causality",
        "process",
        "hierarchy",
        "relationship",
        "decision",
        "narrative",
        "quote",
        "image-led"
      ]
    },
    "componentRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archetype", "layout_variant", "purpose", "required_roles"],
      "properties": {
        "archetype": {"$ref": "#/$defs/slug"},
        "layout_variant": {"$ref": "#/$defs/slug"},
        "purpose": {"type": "string", "minLength": 1},
        "required_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/slug"}
        }
      }
    }
  }
}
