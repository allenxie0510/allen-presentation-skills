{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:allen-ai-skills:presentation-core:theme:0.1",
  "title": "Presentation Theme Pack",
  "description": "A selectable visual expression pack layered on a compatible presentation design system.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "meta", "design_system", "intent", "best_for", "avoid_for", "colors", "stylesheet"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "name_zh", "version", "status", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "name": {"type": "string", "minLength": 1},
        "name_zh": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
        "status": {"enum": ["draft", "review", "approved", "deprecated"]},
        "provenance": {"enum": ["designer-curated", "designer-reviewed-ai-assisted"]}
      }
    },
    "design_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "minimum_version"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "minimum_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"}
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tagline", "mood", "tone", "formality", "density"],
      "properties": {
        "tagline": {"type": "string", "minLength": 1},
        "mood": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "tone": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "formality": {"enum": ["low", "medium", "high"]},
        "density": {"enum": ["low", "medium", "medium-high", "high"]}
      }
    },
    "best_for": {"$ref": "#/$defs/slugList"},
    "avoid_for": {"$ref": "#/$defs/slugList"},
    "colors": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 4, "maxLength": 64},
      "required": ["canvas", "surface", "text_primary", "text_secondary", "accent_primary", "accent_secondary", "positive", "negative", "rule"]
    },
    "stylesheet": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+\\.css$"}
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "slugList": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}}
  }
}
